# Build artifacts
/bin/
# `go build ./cmd/x` writes the binary into the working directory rather than
# into /bin, and a Go binary carries the absolute paths it was built from.
/docsearch
/docsearch-server
/docsearch-worker
/docsearch-eval
/schema-snapshot
*.exe

# Compiled Python left over from the pipeline retired in 7h. Nothing here
# produces bytecode any more, and the caches that survived the deletion
# embed the absolute path of whoever compiled them.
__pycache__/
*.py[cod]

# Runtime state — database, WAL sidecars, ingested library
/var/
*.db
*.db-wal
*.db-shm

# Local secrets
.env
.env.local

# Editor
.DS_Store
# Holds absolute paths to whatever is installed on one machine.
.vscode/
