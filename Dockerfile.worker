# The ingest worker. Separate image from the server because a large PDF
# saturates a core for minutes at a time, which is exactly why extraction
# does not share a process with request handling.
#
# No apt layer, and specifically no ocrmypdf/tesseract/ghostscript/qpdf/
# poppler-utils. That chain was installed here while the worker was Python
# and was never once invoked; it cost 389MB of a 714MB image. Nothing shells
# out now either: every format adapter runs in-process, and the PDF engine is
# PDFium compiled to WebAssembly, which wazero runs with no host dependency.
# ocrmypdf appears only in a warning that tells the operator to OCR a scanned
# PDF before ingesting it. Blocking an image-only document is the deliberate
# behaviour; OCRing it silently is not. If a future adapter genuinely needs
# one of these tools, add back only that tool and say here which code path
# calls it.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath -ldflags="-s -w" \
      -o /out/docsearch-worker ./cmd/docsearch-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/docsearch-worker /usr/local/bin/docsearch-worker
USER nonroot:nonroot
# Database path and library roots come from the ConfigMap. The library is
# mounted at the same path the server sees, so a job's source_path resolves
# in both.
#
# The worker finishes or abandons the job it holds on SIGTERM rather than
# leaving a half-written document; give it room in the Pod spec via
# terminationGracePeriodSeconds.
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/docsearch-worker"]
