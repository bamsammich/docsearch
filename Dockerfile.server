# The MCP server. Pure-Go SQLite driver means CGO_ENABLED=0 and a static
# binary, so the runtime image needs no libc and no FTS5 build tag.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath -ldflags="-s -w" \
      -o /out/docsearch-mcp ./cmd/docsearch-mcp

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/docsearch-mcp /usr/local/bin/docsearch-mcp
USER nonroot:nonroot
EXPOSE 8765
# Bind address, library root and Origin allowlist come from the ConfigMap;
# the bearer token comes from a Secret. Nothing is baked in.
ENTRYPOINT ["/usr/local/bin/docsearch-mcp"]
