[Unit]
Description=docsearch ingest worker
Documentation=https://github.com/bamsammich/docsearch
After=network.target

[Service]
Type=simple
# The DSN carries a password, so it lives in the mode-0600 file beside the
# token rather than in this unit, which `systemctl cat` prints to anyone.
Environment=DOCSEARCH_ROOT=%h/Documents/library
Environment=DOCSEARCH_USER=default
Environment=DOCSEARCH_LOG_LEVEL=INFO
EnvironmentFile=%h/.config/docsearch/token.env
# Migration runs here, before the worker opens the database, because every
# other command refuses an out-of-date schema rather than upgrading it as a
# side effect of being run.
#
# Idempotent, so it costs nothing on the restarts that do not need it. A
# migration that cannot be applied exits nonzero and the unit does not start,
# which is the intended outcome: a worker writing through a schema it does
# not match is worse than a worker that is down.
ExecStartPre=%h/.local/bin/docsearch migrate --dsn ${DOCSEARCH_DSN}
ExecStart=%h/.local/bin/docsearch-worker \
  --dsn ${DOCSEARCH_DSN} \
  --root ${DOCSEARCH_ROOT} \
  --user ${DOCSEARCH_USER}

Restart=on-failure
RestartSec=5

# An in-flight job must reach a checkpoint and roll back its partial rows
# rather than be killed mid-write. Extraction of a large scanned PDF can sit
# inside one unit of work for minutes.
KillSignal=SIGTERM
TimeoutStopSec=900

# The worker reads the library and writes to a database over the network, so
# it needs no writable path of its own.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
