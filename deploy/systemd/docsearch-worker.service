[Unit]
Description=docsearch ingest worker
Documentation=https://github.com/bamsammich/docsearch
After=network.target

[Service]
Type=simple
Environment=DOCSEARCH_DB=%h/.local/share/docsearch/docsearch.db
Environment=DOCSEARCH_ROOT=%h/Documents/library
Environment=DOCSEARCH_LOG_LEVEL=INFO
# Migration runs here and nowhere else. The worker is the only writer, so
# this is the one place a schema change can be applied without racing anything
# -- and it must succeed before the worker opens the database, because every
# other command now refuses an out-of-date schema rather than upgrading it as
# a side effect of being run.
#
# Idempotent, so it costs nothing on the restarts that do not need it. A
# migration that cannot be applied exits nonzero and the unit does not start,
# which is the intended outcome: a worker writing through a schema it does not
# match is worse than a worker that is down.
ExecStartPre=%h/.local/bin/docsearch migrate --db ${DOCSEARCH_DB}
ExecStart=%h/.local/bin/docsearch worker --db ${DOCSEARCH_DB} --root ${DOCSEARCH_ROOT}

Restart=on-failure
RestartSec=5

# An in-flight job must reach a checkpoint and roll back its partial rows
# rather than be killed mid-write. Extraction of a large scanned PDF can sit
# inside one unit of work for minutes.
KillSignal=SIGTERM
TimeoutStopSec=900

# The worker reads the library and writes exactly one database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/docsearch

[Install]
WantedBy=default.target
