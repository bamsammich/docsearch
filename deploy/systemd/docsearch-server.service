[Unit]
Description=docsearch MCP server
Documentation=https://github.com/bamsammich/docsearch
After=network.target
# Not a hard dependency: the server serves reads whether or not the worker is
# up, and /readyz reflects the database rather than the worker.
Wants=docsearch-worker.service

[Service]
Type=simple
Environment=DOCSEARCH_ROOT=%h/Documents/library
Environment=DOCSEARCH_ADDR=127.0.0.1:8765
Environment=DOCSEARCH_ALLOWED_ORIGINS=https://claude.ai
# The token and the DSNs live in a mode-0600 file, not in this unit, so
# none reaches `systemctl cat`. DOCSEARCH_DSN there is the request role's,
# docsearch_app; the owner's goes in DOCSEARCH_OWNER_DSN, which only
# `docsearch migrate` and `docsearch account` read. The server takes its DSN
# from the environment rather than a flag, since an argument is visible to
# every process on the host through ps.
EnvironmentFile=%h/.config/docsearch/token.env

ExecStart=%h/.local/bin/docsearch-server \
  --root ${DOCSEARCH_ROOT} \
  --addr ${DOCSEARCH_ADDR} \
  --allowed-origins ${DOCSEARCH_ALLOWED_ORIGINS}

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/docsearch

[Install]
WantedBy=default.target
