<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS user agent for the ingest worker.

  Install:
    sed "s|__HOME__|$HOME|g" deploy/launchd/com.bamsammich.docsearch-worker.plist \
      > ~/Library/LaunchAgents/com.bamsammich.docsearch-worker.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bamsammich.docsearch-worker.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bamsammich.docsearch-worker</string>

  <!-- launchd has no ExecStartPre, so the migration runs as the first half of
       a shell wrapper, the same shape the server agent uses to source its
       token. `&&` is what makes it a precondition: a migration that cannot be
       applied exits nonzero and the worker is never exec'd, because a worker
       writing through a schema it does not match is worse than one that is
       down. The command is idempotent, so it costs nothing on the restarts
       that need no migration.

       The worker is the only writer, which is what makes this the one correct
       place to run it. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>DB="$HOME/.local/share/docsearch/docsearch.db"; "$HOME/.local/bin/docsearch" migrate --db "$DB" &amp;&amp; exec "$HOME/.local/bin/docsearch" worker --db "$DB" --root "$HOME/Documents/docsearch-library"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <!-- Restart only on unsuccessful exit. A schema the build cannot migrate
       fails identically every time, so this would otherwise spin: the log
       records the reason on each attempt, and `docsearch migrate --check`
       reports it without starting anything. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/docsearch/worker.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/docsearch/worker.log</string>

  <!-- Extraction is CPU-heavy for minutes at a time. Background priority keeps
       it from competing with interactive work; the queue is not latency
       sensitive and a job taking somewhat longer is invisible to the caller. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>

  <!-- launchd sends SIGTERM then SIGKILL after this. The worker checkpoints or
       rolls back its partial rows on SIGTERM; give it room to finish rather
       than being killed mid-write. -->
  <key>ExitTimeOut</key>
  <integer>900</integer>
</dict>
</plist>
