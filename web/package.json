{
  "name": "docsearch-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The library UI docsearch-server embeds and serves.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "generate": "cd .. && buf generate --template web/buf.gen.yaml"
